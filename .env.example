PORT=3000
ENDPOINTS_BASE_URL=https://your-public-domain.example.com
SALESFORCE_APPLICATION_EXTENSION_KEY=your-installed-package-extension-key
# Required: positive integer. Sets the /version{N} subpath and the dylan-version header on /validate.
# Register https://your-public-domain.example.com/version{N} in SFMC. Increment to force a config re-fetch.
VERSION=1
