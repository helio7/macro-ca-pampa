PORT=3000
ENDPOINTS_BASE_URL=https://your-public-domain.example.com
SALESFORCE_APPLICATION_EXTENSION_KEY=your-installed-package-extension-key
# Optional: set a subpath so Salesforce detects a URL change and re-fetches config.json.
# Example: BASE_PATH=/version123 → register https://your-public-domain.example.com/version123 in SFMC.
# When set, also append the same subpath to ENDPOINTS_BASE_URL above.
# BASE_PATH=
# Optional: only set this if you later decide to expose an execute endpoint elsewhere.
# JB_EXECUTE_URL=https://your-public-domain.example.com/journeybuilder/execute
